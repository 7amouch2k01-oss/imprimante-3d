# Environment Variables for Production & Railway Deployment

# 1. Database connection string (Railway PostgreSQL or Supabase)
# Railway automatically populates this when you add a PostgreSQL service:
DATABASE_URL="postgresql://postgres:password@roundhouse.proxy.rlwy.net:5432/railway"

# 2. Application Base URL (e.g. https://your-project.up.railway.app)
NEXT_PUBLIC_APP_URL="https://your-project.up.railway.app"

# 3. Secure Auth Secret for JWT (Generate with `openssl rand -base64 32`)
JWT_SECRET="cbv-super-secure-production-jwt-token-key-2026-additive"

# 4. Environment
NODE_ENV="production"

# 5. Optional Stripe Keys (Optional for live payments, built-in mock fallback enabled)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
