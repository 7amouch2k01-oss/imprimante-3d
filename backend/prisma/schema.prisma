datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User: Id, email, passwordHash, role (CUSTOMER, ADMIN)
model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         String   @default("CUSTOMER") // "CUSTOMER" | "ADMIN"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders  Order[]
  reviews Review[]

  @@map("users")
}

// Product: Id, slug, price, stock, images, category ('PRINTER', 'RECYCLING_EQUIPMENT')
model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  price        Float
  comparePrice Float?
  stock        Int      @default(0)
  images       String   // JSON string array of image URLs
  category     String   @default("PRINTER") // 'PRINTER' | 'RECYCLING_EQUIPMENT'
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  translations ProductTranslation[]
  orderItems   OrderItem[]
  reviews      Review[]

  @@index([category])
  @@index([slug])
  @@map("products")
}

// ProductTranslation: Foreign key to Product, languageCode ('en', 'fr'), name, description, specs (JSON)
model ProductTranslation {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  languageCode String   // 'en' | 'fr'
  name         String
  description  String
  specs        String   // JSON string containing key-value technical specifications
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([productId, languageCode])
  @@index([languageCode])
  @@map("product_translations")
}

// Order & OrderItem: Transactions, payment status, customer details
model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String
  customerEmail   String
  shippingAddress String      // JSON string of address details
  totalAmount     Float
  currency        String      @default("EUR")
  status          String      @default("PENDING") // PENDING, PROCESSING, COMPLETED, CANCELLED
  paymentStatus   String      @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  paymentMethod   String      @default("STRIPE")
  stripeSessionId String?     @unique
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerEmail])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Float
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// RecyclingWaitlist: Email, preferredLanguage, createdAt
model RecyclingWaitlist {
  id                String   @id @default(cuid())
  email             String   @unique
  preferredLanguage String   @default("en") // 'en' | 'fr'
  createdAt         DateTime @default(now())

  @@index([email])
  @@map("recycling_waitlists")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("reviews")
}
